# ──────────────────────────────────────────────
# RAGScope — Environment Configuration
# Copy to .env and fill in values
# ──────────────────────────────────────────────

# ── Database ──────────────────────────────────
POSTGRES_USER=ragscope
POSTGRES_PASSWORD=changeme_in_production
POSTGRES_DB=ragscope
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_HOST}:${POSTGRES_PORT}/${POSTGRES_DB}

# ── Redis ─────────────────────────────────────
REDIS_URL=redis://redis:6379/0

# ── Ollama (Self-Hosted LLM) ──────────────────
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_MODEL=llama3.1:8b
OLLAMA_EMBEDDING_MODEL=nomic-embed-text

# ── Embedding (Dual Registry) ────────────────
# Options: "gemini", "bge-m3", "ollama"
DEFAULT_EMBEDDING_PROVIDER=ollama
GEMINI_API_KEY=
GEMINI_EMBEDDING_MODEL=text-embedding-004

# ── Ingestion ─────────────────────────────────
DEFAULT_CHUNK_SIZE=512
DEFAULT_CHUNK_OVERLAP=50
DEFAULT_CHUNKER=recursive

# ── Retrieval ─────────────────────────────────
RETRIEVAL_TOP_K=20
RERANK_TOP_K=5
RRF_K=60
SEMANTIC_CACHE_THRESHOLD=0.85

# ── Observability / Tracing ───────────────────
# Fraction of traces persisted to Postgres (1.0 = all, 0.1 = 10% sampling)
TRACE_SAMPLING_RATE=1.0
# Also print spans to stdout (dev debugging)
TRACE_CONSOLE_EXPORT=false
# Optional OTLP HTTP endpoint to forward spans to (Grafana Tempo / Phoenix)
OTLP_ENDPOINT=

# ── Application ───────────────────────────────
APP_NAME=RAGScope
APP_ENV=development
LOG_LEVEL=INFO
API_HOST=0.0.0.0
API_PORT=8000

# ── Frontend ──────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
